# Placeholder template only. Put real local values in .env.local, never here.
# Never print credentials, connection strings, or bootstrap passwords to logs.

# ================================================
# APPLICATION
# ================================================

# The only public environment variable in this contract.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production:
# NEXT_PUBLIC_SITE_URL=https://yogaagustiansyah.my.id


# ================================================
# DATABASE — AIVEN POSTGRESQL
# ================================================

# Server-only. Next.js and Drizzle Kit must share this value from .env.local.
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database>?sslmode=require

# Server-only. Base64-encode the Aiven ca.pem as one line. The application
# validates and decodes it before passing it to postgres.js and Drizzle Kit.
DATABASE_CA_CERT_BASE64=<base64-encoded-aiven-ca-pem>


# ================================================
# BETTER AUTH
# ================================================

# Server-only. Generate the real secret outside this tracked template.
BETTER_AUTH_SECRET=<generate-a-high-entropy-secret-at-least-32-characters>
BETTER_AUTH_URL=http://localhost:3000

# Production:
# BETTER_AUTH_URL=https://yogaagustiansyah.my.id


# ================================================
# CLOUDINARY
# ================================================

# Server-only. This URL includes the API secret and must never reach the browser.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

CLOUDINARY_FOLDER_ROOT=yogaaa-portfolio


# ================================================
# OWNER BOOTSTRAP — TEMPORARY
# ================================================

# Server-only inputs for an explicit, one-time owner provisioning command.
# Do not expose a public bootstrap endpoint or enable public registration.
# After reviewing/applying migrations, run: npm run auth:bootstrap-owner
# Use a temporary password of 12–128 characters; never put it in CLI arguments.
BOOTSTRAP_OWNER_NAME=Yoga Agustiansyah
BOOTSTRAP_OWNER_EMAIL=<owner-email>
BOOTSTRAP_OWNER_PASSWORD=<temporary-bootstrap-password>

# BOOTSTRAP_OWNER_PASSWORD must be removed from the production environment
# after owner provisioning succeeds. Remove its real local value when no longer
# needed and change the temporary login password through a secure owner flow.
# Normal login and authorization must not depend on bootstrap environment values.
