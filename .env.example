# Copy to .env.local for local development. Never commit real credentials.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase web config: identifiers used by the browser for owner sign-in.
NEXT_PUBLIC_FIREBASE_API_KEY=<firebase-web-api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<project-id>
NEXT_PUBLIC_FIREBASE_APP_ID=<firebase-web-app-id>

# Server-only Firebase Admin configuration and the one allowed CMS account.
FIREBASE_PROJECT_ID=<project-id>
FIREBASE_OWNER_UID=<firebase-auth-owner-uid>

# Local: use an absolute service-account JSON path outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=C:/absolute/private/path/service-account.json

# Vercel: set these two variables instead of GOOGLE_APPLICATION_CREDENTIALS.
# Escape private-key newlines as \n in the dashboard variable.
# FIREBASE_ADMIN_CLIENT_EMAIL=<service-account-email>
# FIREBASE_ADMIN_PRIVATE_KEY=<service-account-private-key>

# Server-only Cloudinary credentials; never expose this URL to the browser.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER_ROOT=yogaaa-portfolio

# Only for explicit data:seed / data:verify commands. Must match FIREBASE_PROJECT_ID.
# CONFIRM_FIREBASE_PROJECT=<project-id>

# Local Firebase emulators only. Set both together when used.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
