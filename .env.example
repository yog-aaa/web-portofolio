# Placeholder template only. Put real local values in .env.local, never here.
# Never print credentials, connection strings, or bootstrap passwords to logs.
# Local development uses the localhost values below. Production requires every
# active legacy variable in this file, with the two documented HTTPS origins.
# BOOTSTRAP_OWNER_* values are temporary provisioning inputs, not runtime config.

# ================================================
# APPLICATION
# ================================================

# The only public environment variable in this contract.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production:
# NEXT_PUBLIC_SITE_URL=https://yogaagustiansyah.my.id


# ================================================
# DATABASE — AIVEN POSTGRESQL
# ================================================

# Server-only; required wherever database-backed content/auth runs. Next.js and
# Drizzle Kit must share this value from .env.local during local development.
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database>?sslmode=require

# Server-only and required with DATABASE_URL. Base64-encode the Aiven ca.pem as one line. The application
# validates and decodes it before passing it to postgres.js and Drizzle Kit.
DATABASE_CA_CERT_BASE64=<base64-encoded-aiven-ca-pem>


# ================================================
# BETTER AUTH
# ================================================

# Server-only and required in production. Generate the real secret outside this tracked template.
BETTER_AUTH_SECRET=<generate-a-high-entropy-secret-at-least-32-characters>
BETTER_AUTH_URL=http://localhost:3000

# Production:
# BETTER_AUTH_URL=https://yogaagustiansyah.my.id


# ================================================
# CLOUDINARY
# ================================================

# Server-only and required for media operations. This URL includes the API secret
# and must never reach the browser.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

CLOUDINARY_FOLDER_ROOT=yogaaa-portfolio


# ================================================
# OWNER BOOTSTRAP — TEMPORARY
# ================================================

# Server-only inputs for an explicit, one-time owner provisioning command.
# Do not expose a public bootstrap endpoint or enable public registration.
# After reviewing/applying migrations, run: npm run auth:bootstrap-owner
# Use a temporary password of 12–128 characters; never put it in CLI arguments.
BOOTSTRAP_OWNER_NAME=Yoga Agustiansyah
BOOTSTRAP_OWNER_EMAIL=<owner-email>
BOOTSTRAP_OWNER_PASSWORD=<temporary-bootstrap-password>

# BOOTSTRAP_OWNER_PASSWORD must be removed from the production environment
# after owner provisioning succeeds. Remove its real local value when no longer
# needed and change the temporary login password through a secure owner flow.
# Normal login and authorization must not depend on bootstrap environment values.


# ================================================
# OWNER PASSWORD RECOVERY — TEMPORARY
# ================================================

# Server-only inputs for the explicit offline recovery command. Set these only
# after verifying the database target and owner email, then run:
# npm run auth:reset-owner-password -- --confirm-owner-password-reset
RESET_OWNER_EMAIL=<owner-email>
RESET_OWNER_PASSWORD=<new-owner-password>

# Remove both recovery values immediately after the command succeeds. The reset
# preserves the owner identity and revokes every existing owner session.


# ================================================
# FIREBASE MIGRATION (not active until auth/data adapters replace legacy code)
# ================================================

# Public Firebase web app config. These are identifiers, not service-account secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=<firebase-web-api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<project-id>
NEXT_PUBLIC_FIREBASE_APP_ID=<firebase-web-app-id>

# Server-only configuration. Owner authorization compares UID, never email.
FIREBASE_PROJECT_ID=<project-id>
FIREBASE_OWNER_UID=<firebase-auth-owner-uid>
FIREBASE_ADMIN_CLIENT_EMAIL=<service-account-email>
FIREBASE_ADMIN_PRIVATE_KEY=<service-account-private-key-with-escaped-newlines>

# For local development, instead of the two ADMIN_* variables above, point to a
# service account JSON file outside the repository. Never commit the JSON file.
# GOOGLE_APPLICATION_CREDENTIALS=C:/absolute/private/path/service-account.json

# Local emulator testing only; omit for production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
